# 包装脚本参数
HOLOMOTION_ROOT=/abs/path/to/HoloMotion
TRAIN_PY=/abs/path/to/.venv-holoboxing/bin/python
RETARGET_PY=/abs/path/to/.venv-holoboxing-retarget/bin/python
HOLOBOXING_ASSETS=/abs/path/to/HoloMotion/holoboxing/assets
DATA_ROOT=./data
WORKERS=1
SMPL_MODEL=/abs/path/to/smpl/SMPL_NEUTRAL.pkl

# 对应官方命令（由脚本内部调用）
# holoboxing.data download ... --workers
# holoboxing.data retarget ... --smpl-model --assets
# holoboxing.data prepare ... --workers --assets
# holoboxing.data verify ... --assets
